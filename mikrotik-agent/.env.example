# =============================================================================
# Agent configuration. Nakili faili hii kuwa ".env" na ujaze thamani halisi.
#   cp .env.example .env
# USIWEKE .env kwenye Git. USIWEKE MikroTik password hapa (inatoka Supabase Vault).
# =============================================================================

# Supabase project yako (System URL)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Supabase anon key (public — ni sawa kuwa hapa)
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Agent token — pata kutoka Dashboard (My Routers/Agents ukisajili agent)
AGENT_TOKEN=YOUR_AGENT_TOKEN
